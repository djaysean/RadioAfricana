+    @Nullable
+    private String getIcyParameter(String streamUrl, String parameter) {
+        if (streamUrl == null || streamUrl.trim().isEmpty()) {
+            return null;
+        }
+
+        try {
+            String query = streamUrl.trim();
+
+            // The station sends the parameter string beginning with '&'.
+            // Uri expects the query to follow a '?', so normalize it first.
+            if (query.startsWith("?")) {
+                query = query.substring(1);
+            } else if (query.startsWith("&")) {
+                query = query.substring(1);
+            }
+
+            Uri metadataUri = Uri.parse("https://radioafricana.com/?" + query);
+            String value = metadataUri.getQueryParameter(parameter);
+
+            if (value != null && !value.trim().isEmpty()) {
+                return value.trim();
+            }
+        } catch (Exception e) {
+            DebugLog.w(
+                    TAG,
+                    "Could not parse ICY parameter '" + parameter + "': "
+                            + e.getMessage()
+            );
+        }
+
+        return null;
+    }
