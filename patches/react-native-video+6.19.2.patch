+    /**
+     * Parses the custom Radio Africana ICY StreamUrl metadata.
+     *
+     * Radio Africana sends StreamUrl in this form:
+     *
+     * &artist=Artist+Name&title=Song+Title&album=&duration=309185
+     * &songtype=S&overlay=no&buycd=&website=&picture=Artwork.jpg
